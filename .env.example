# 复制为 .env 并填入你自己的 key。
# DeepSeek（推荐，便宜且国内可用）


# DeepSeek：
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-chat

# 其他兼容服务举例（按需取消注释）
# Qwen / 通义：LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
# OpenAI：    LLM_BASE_URL=（留空）                                   LLM_MODEL=gpt-4o

LLM_TEMPERATURE=0.2
LLM_MAX_ITERATIONS=20
LLM_REVIEW_LANGUAGE=zh

# ===== RAG 知识库（可选，配合 --kb 使用）=====
# 阿里 DashScope 的 embedding（文本向量化）。
# 不填 EMBEDDING_API_KEY 时，--kb 会自动回退到内置的 TF-IDF 检索（无需向量库也能用）。
EMBEDDING_API_KEY=sk-xxxx
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

# ===== GitHub PR bot（可选，配合 code-review-pr 使用）=====
# GitHub Personal Access Token（需要 repo 权限，用于拉取 PR diff 和发评论）
GITHUB_TOKEN=ghp_xxxx
# webhook 的 secret（配置 GitHub webhook 时填同样的值，用于校验请求签名）
GITHUB_WEBHOOK_SECRET=随便填一个随机字符串
